# Copy to .env locally. Never commit real credentials.
APP_ENV=development
APP_NAME=FAYDA ID BOT
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fayda_bot
REDIS_URL=redis://localhost:6379/0
# JSON map of server-approved service codes to ETB prices; never accept prices from clients.
SERVICE_CATALOG_JSON={}
# Configure trusted merchant receiver details after confirming provider account data.
CBE_RECEIVER_NAME=
CBE_RECEIVER_ACCOUNT_SUFFIX=
TELEBIRR_RECEIVER_NAME=
TELEBIRR_RECEIVER_ACCOUNT_SUFFIX=
# Resident API authorization value from the approved Fayda integration. Keep it only in Railway secrets.
FAYDA_RESIDENT_AUTHORIZATION=
# Additional official API settings, if required by the approved integration.
FAYDA_API_BASE_URL=
FAYDA_CLIENT_ID=
FAYDA_CLIENT_SECRET=
